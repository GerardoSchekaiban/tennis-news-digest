# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml). Later swap for your Neon connection string.
DATABASE_URL=postgresql://digest:digest@localhost:5432/digest

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5
COMPOSE_MODEL=claude-sonnet-5-5

# Embeddings (milestone 6). Pick a provider, e.g. Voyage AI or a local sentence-transformers model.
VOYAGE_API_KEY=

# Email (milestone 8), e.g. https://resend.com
RESEND_API_KEY=
DIGEST_FROM=digest@yourdomain.com
DIGEST_TO=you@example.com
